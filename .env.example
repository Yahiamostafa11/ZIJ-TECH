# Contact form (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-a-secret
SMTP_FROM=mailer@example.com
CONTACT_EMAIL=inbox@example.com

# Portal database (MariaDB / MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/zij
DATABASE_POOL_SIZE=5

# Portal authentication. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
